# ==============================================================================
# PERIPHERAL COGNITIVE MESH (PCM) — LIVE BENCHMARK CONFIGURATION
# ==============================================================================
# Copy this file to .env and provide your API keys to run live head-to-head
# evaluations against Mem0 and Zep:
#
#   cp .env.example .env
#   bun run benchmark:live
# ==============================================================================

# --- Mem0 Configuration ---
# To run Mem0 in open-source (OSS) mode, provide an OpenAI API key (used by Mem0 for write-time fact extraction):
OPENAI_API_KEY=

# Alternatively, if you have a Mem0 Cloud managed account, provide your Mem0 API key:
MEM0_API_KEY=

# --- Zep Cloud Configuration ---
# If you have a Zep Cloud account, provide your Zep API key:
ZEP_API_KEY=
